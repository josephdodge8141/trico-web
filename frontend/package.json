{
  "name": "@app/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --port 4173",
    "test:unit": "node --import tsx --test services/*.test.ts",
    "test:browser": "npm --prefix .. run build:contracts && npm --prefix .. run build -w @app/backend && npm run build && playwright test",
    "test:browser:compose": "playwright test --config playwright.compose.config.ts",
    "test:behaviors:compose": "node --import tsx ../packages/cucumber/catalog/run-layer.ts frontend steps/application.steps.ts",
    "preview:test": "vite preview"
  },
  "dependencies": {
    "@app/schemas": "0.1.0",
    "@fontsource/open-sans": "5.3.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "0.575.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@app/behaviors": "0.1.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7"
  }
}
